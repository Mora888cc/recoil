-- ============================================================================
-- 3. EXECUTOR CAPABILITY PROBE
-- ============================================================================

local function fetchGlobal(name)
    local ok, value = pcall(function()
        return REGISTRY_ENV[name]
    end)
    if ok and value ~= nil then
        return value
    end
    local okGlobal, globalValue = pcall(function()
        return _G[name]
    end)
    if okGlobal and globalValue ~= nil then
        return globalValue
    end
    return nil
end

local function asFunction(value)
    if type(value) == "function" then
        return value
    end
    return nil
end

local EXEC = {
    identify = asFunction(fetchGlobal("identifyexecutor")),
    hook = asFunction(fetchGlobal("hookfunction")) or asFunction(fetchGlobal("replaceclosure")),
    getUpvalues = asFunction(fetchGlobal("getupvalues")),
    setUpvalue = asFunction(fetchGlobal("setupvalue")),
    getRawMeta = asFunction(fetchGlobal("getrawmetatable")),
    setReadonly = asFunction(fetchGlobal("setreadonly")),
    isReadonly = asFunction(fetchGlobal("isreadonly")),
    makeWriteable = asFunction(fetchGlobal("make_writeable")),
    getUpvalueName = nil,
    setClipboard = asFunction(fetchGlobal("setclipboard")) or asFunction(fetchGlobal("toclipboard")),
    writeFile = asFunction(fetchGlobal("writefile")),
    readFile = asFunction(fetchGlobal("readfile")),
    isFile = asFunction(fetchGlobal("isfile")),
    makeFolder = asFunction(fetchGlobal("makefolder")),
    isFolder = asFunction(fetchGlobal("isfolder")),
}

do
    local dbg = fetchGlobal("debug")
    if type(dbg) == "table" then
        if not EXEC.getUpvalues and type(dbg.getupvalues) == "function" then
            EXEC.getUpvalues = function(fn)
                return dbg.getupvalues(fn)
            end
        end
        if not EXEC.setUpvalue and type(dbg.setupvalue) == "function" then
            EXEC.setUpvalue = function(fn, index, value)
                return dbg.setupvalue(fn, index, value)
            end
        end
        if type(dbg.getupvalue) == "function" then
            EXEC.getUpvalueName = function(fn, index)
                return dbg.getupvalue(fn, index)
            end
        end
    end
end

-- ============================================================================
-- 4. UTILITY LAYER
-- ============================================================================

local Diag = nil

local function diag(level, text)
    if Diag then
        Diag.push(level, text)
    else
        print("[pena] " .. tostring(level) .. ": " .. tostring(text))
    end
end

local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end
    if value > maximum then
        return maximum
    end
    return value
end

local function round(value)
    return math.floor(value + 0.5)
end

local function safeCall(label, fn, ...)
    local results = table.pack(pcall(fn, ...))
    if not results[1] then
        diag("error", label .. ": " .. tostring(results[2]))
        return false
    end
    return true, table.unpack(results, 2, results.n)
end

local Connections = {}

local function connect(signal, handler)
    if not signal then
        diag("warn", "connection skipped: signal unavailable")
        return nil
    end
    local ok, connection = pcall(function()
        return signal:Connect(handler)
    end)
    if not ok or not connection then
        diag("warn", "connection failed: " .. tostring(signal))
        return nil
    end
    Connections[#Connections + 1] = connection
    return connection
end

local function dropConnection(connection)
    if not connection then
        return
    end
    safeCall("dropConnection", function()
        connection:Disconnect()
    end)
    for index = #Connections, 1, -1 do
        if Connections[index] == connection then
            table.remove(Connections, index)
        end
    end
end

local function disconnectAll()
    for index = #Connections, 1, -1 do
        local connection = Connections[index]
        Connections[index] = nil
        if connection then
            safeCall("disconnectAll", function()
                connection:Disconnect()
            end)
        end
    end
end

local function writeKey(tbl, key, value)
    if type(tbl) ~= "table" then
        return false, "not a table"
    end

    local okDirect = pcall(function()
        tbl[key] = value
    end)
    if okDirect and rawget(tbl, key) == value then
        return true
    end

    local locked = false
    if EXEC.isReadonly then
        local okState, state = pcall(EXEC.isReadonly, tbl)
        if okState then
            locked = state == true
        end
    end

    if locked and EXEC.setReadonly then
        safeCall("writeKey/unlock", EXEC.setReadonly, tbl, false)
        local okWrite = pcall(function()
            tbl[key] = value
        end)
        safeCall("writeKey/relock", EXEC.setReadonly, tbl, true)
        if okWrite and rawget(tbl, key) == value then
            return true
        end
    end

    if EXEC.makeWriteable then
        safeCall("writeKey/makeWriteable", EXEC.makeWriteable, tbl)
        local okWrite = pcall(function()
            tbl[key] = value
        end)
        if okWrite and rawget(tbl, key) == value then
            return true
        end
    end

    return false, "write blocked"
end

local function walkGraph(root, maxDepth, budget, visit)
    local visited = {}
    local work = 0
    local stack = { { value = root, depth = 0 } }

    while #stack > 0 and work < budget do
        local entry = table.remove(stack)
        local value = entry.value
        local depth = entry.depth
        local kind = type(value)

        if (kind == "table" or kind == "function") and depth <= maxDepth and not visited[value] then
            visited[value] = true
            work = work + 1
            visit(value, kind, depth)

            if kind == "table" then
                for _, child in pairs(value) do
                    local childKind = type(child)
                    if childKind == "table" or childKind == "function" then
                        stack[#stack + 1] = { value = child, depth = depth + 1 }
                    end
                end
            elseif EXEC.getUpvalues then
                local okList, list = pcall(EXEC.getUpvalues, value)
                if okList and type(list) == "table" then
                    for _, child in ipairs(list) do
                        local childKind = type(child)
                        if childKind == "table" or childKind == "function" then
                            stack[#stack + 1] = { value = child, depth = depth + 1 }
                        end
                    end
                end
            end
        end
    end

    return work
end

local ShotBus = {
    listeners = {},
    sourceKind = nil,
}

function ShotBus.subscribe(listener)
    ShotBus.listeners[#ShotBus.listeners + 1] = listener
    return function()
        for index = #ShotBus.listeners, 1, -1 do
            if ShotBus.listeners[index] == listener then
                table.remove(ShotBus.listeners, index)
            end
        end
    end
end

function ShotBus.fire(look, cameraCFrame)
    for index = 1, #ShotBus.listeners do
        local ok, err = pcall(ShotBus.listeners[index], look, cameraCFrame)
        if not ok then
            diag("error", "shot listener failed: " .. tostring(err))
        end
    end
end

function ShotBus.clear()
    table.clear(ShotBus.listeners)
    ShotBus.sourceKind = nil
end

local function getLocalCharacter()
    local players = Services.Players
    if not players then
        return nil
    end
    local player = players.LocalPlayer
    if not player then
        return nil
    end
    return player.Character
end

local function isCharacterDead()
    local character = getLocalCharacter()
    if not character then
        return true
    end
    local okDead, dead = pcall(function()
        return character:GetAttribute("Dead")
    end)
    if okDead and dead == true then
        return true
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return true
    end
    return false
end

-- ============================================================================
-- 5. GAME SURFACE RESOLVER
-- ============================================================================

local Surface = {}

local MODULE_TTL = 10
local SCAN_DEPTH_LIMIT = 4
local SCAN_NODE_BUDGET = 500
local SCAN_QUEUE_CEILING = 2000
local moduleCache = {}

local function resolveNode(path)
    local node = Services.ReplicatedStorage
    if not node then
        return nil
    end
    for _, name in ipairs(path) do
        local ok, child = pcall(function()
            return node:FindFirstChild(name)
        end)
        if not ok or not child then
            return nil
        end
        node = child
    end
    return node
end

function Surface.requirePath(path)
    local key = table.concat(path, ".")
    local cached = moduleCache[key]
    if cached and (os.clock() - cached.time) < MODULE_TTL then
        return cached.value, cached.instance
    end

    local node = resolveNode(path)
    if not node then
        return nil, "missing: " .. key
    end

    local ok, result = pcall(require, node)
    if not ok then
        return nil, "require failed: " .. key .. " (" .. tostring(result) .. ")"
    end

    moduleCache[key] = { value = result, instance = node, time = os.clock() }
    return result, node
end

function Surface.clearCache()
    table.clear(moduleCache)
end

function Surface.findWeaponModule()
    local root = Services.ReplicatedStorage
    if not root then
        return nil, "ReplicatedStorage unavailable"
    end

    local queue = { { node = root, depth = 0 } }
    local head = 1
    local budget = SCAN_NODE_BUDGET

    while head <= #queue and budget > 0 do
        local entry = queue[head]
        head = head + 1
        budget = budget - 1

        local node = entry.node
        local depth = entry.depth

        if node:IsA("ModuleScript") then
            local ok, module = pcall(require, node)
            if ok and type(module) == "table" and type(module.shoot) == "function" then
                return module, node
            end
        end

        if depth < SCAN_DEPTH_LIMIT and #queue < SCAN_QUEUE_CEILING then
            local okChildren, children = pcall(function()
                return node:GetChildren()
            end)
            if okChildren and children then
                for _, child in ipairs(children) do
                    queue[#queue + 1] = { node = child, depth = depth + 1 }
                end
            end
        end
    end

    local fallbackPath = { "Components", "Weapon" }
    local fallback = Surface.requirePath(fallbackPath)
    if type(fallback) == "table" and type(fallback.shoot) == "function" then
        return fallback, resolveNode(fallbackPath)
    end

    return nil, "weapon module not located"
end

function Surface.findCameraController()
    local direct = Surface.requirePath({ "Controllers", "CameraController" })
    if type(direct) == "table" then
        return direct, resolveNode({ "Controllers", "CameraController" })
    end

    local root = Services.ReplicatedStorage
    if not root then
        return nil, "ReplicatedStorage unavailable"
    end

    local queue = { { node = root, depth = 0 } }
    local head = 1
    local budget = SCAN_NODE_BUDGET

    while head <= #queue and budget > 0 do
        local entry = queue[head]
        head = head + 1
        budget = budget - 1
        local node = entry.node
        local depth = entry.depth

        if node:IsA("ModuleScript") and string.find(string.lower(node.Name), "camera", 1, true) then
            local ok, module = pcall(require, node)
            if ok and type(module) == "table" then
                return module, node
            end
        end

        if depth < SCAN_DEPTH_LIMIT and #queue < SCAN_QUEUE_CEILING then
            local okChildren, children = pcall(function()
                return node:GetChildren()
            end)
            if okChildren and children then
                for _, child in ipairs(children) do
                    queue[#queue + 1] = { node = child, depth = depth + 1 }
                end
            end
        end
    end

    return nil, "camera controller not located"
end

-- ============================================================================
-- 6. NO SPREAD
-- ============================================================================

local SWEEP_DEPTH = 3
local SWEEP_WRITE_BUDGET = 5000
local SWEEP_TIME_CEILING = 0.25

local NoSpread = {
    enabled = false,
    mode = "off",
    upvalues = 0,
    restores = {},
    originalRandom = nil,
    patchedGlobal = false,
    randomHookOriginal = nil,
    detour = nil,
    detourOriginal = nil,
    detourKind = nil,
}

-- Deterministic stand-in for math.random.
--   random()     -> 0.5   midpoint, zero bias in either direction
--   random(m)    -> 1     spread call sites index a deviation table; index 1 is
--                         the smallest cone available
--   random(a, b) -> midpoint, integer-safe, clamped into the passed range
local function spreadRandom(a, b)
    if a == nil then
        return 0.5
    end
    if b == nil then
        if type(a) ~= "number" then
            return 0.5
        end
        return 1
    end
    if type(a) ~= "number" or type(b) ~= "number" then
        return 0.5
    end
    local low = math.min(a, b)
    local high = math.max(a, b)
    local mid = math.floor((low + high) / 2 + 0.5)
    return clamp(mid, low, high)
end

function NoSpread.collectRoots()
    local roots = {}
    local weapon = Surface.findWeaponModule()
    if weapon then
        roots[#roots + 1] = weapon
    end

    local extraPaths = {
        { "Components", "Weapon", "Classes", "Bullet" },
        { "Shared", "Raycast" },
        { "Components", "Common", "GetRayIgnore" },
        { "Controllers", "InventoryController" },
    }

    for _, path in ipairs(extraPaths) do
        local module = Surface.requirePath(path)
        if module ~= nil then
            roots[#roots + 1] = module
        end
    end

    local camera = Surface.findCameraController()
    if camera ~= nil then
        roots[#roots + 1] = camera
    end

    return roots
end

function NoSpread.sweep(roots)
    if not EXEC.getUpvalues or not EXEC.setUpvalue then
        return false
    end

    local original = NoSpread.originalRandom or math.random
    local deadline = os.clock() + SWEEP_TIME_CEILING
    local writes = 0

    for _, root in ipairs(roots) do
        walkGraph(root, SWEEP_DEPTH, SWEEP_WRITE_BUDGET, function(value, kind)
            if os.clock() > deadline or writes >= SWEEP_WRITE_BUDGET then
                return
            end
            if kind ~= "function" then
                return
            end

            local okList, list = pcall(EXEC.getUpvalues, value)
            if not okList or type(list) ~= "table" then
                return
            end

            for index = 1, #list do
                if list[index] == original then
                    local okSet = pcall(EXEC.setUpvalue, value, index, spreadRandom)
                    if okSet then
                        NoSpread.restores[#NoSpread.restores + 1] = {
                            fn = value,
                            index = index,
                            original = original,
                        }
                        NoSpread.upvalues = NoSpread.upvalues + 1
                        writes = writes + 1
                    end
                end
            end
        end)
    end

    return NoSpread.upvalues > 0
end

function NoSpread.patchGlobal()
    if math.random == spreadRandom then
        NoSpread.patchedGlobal = true
        return true
    end

    local original = math.random
    local ok = writeKey(math, "random", spreadRandom)
    if ok then
        NoSpread.originalRandom = original
        NoSpread.patchedGlobal = true
        return true
    end

    return false, "math.random write blocked"
end

local DIRECTION_KEY_HINTS = {
    dir = true,
    direction = true,
    look = true,
    lookvector = true,
    aim = true,
    spread = true,
}

local function rewriteDirectionArguments(packed)
    local workspace = Services.Workspace
    local camera = workspace and workspace.CurrentCamera
    if not camera then
        return false
    end

    local look = camera.CFrame.LookVector
    local changed = false

    for index = 1, packed.n do
        local value = packed[index]
        local kind = typeof(value)

        if kind == "Vector3" then
            -- Only unit-length vectors are directions; anything else is a
            -- position and is passed through untouched.
            if math.abs(value.Magnitude - 1) < 0.02 then
                packed[index] = look
                changed = true
            end
        elseif kind == "CFrame" then
            packed[index] = CFrame.new(value.Position) * CFrame.lookAt(Vector3.zero, look)
            changed = true
        elseif kind == "table" then
            for key, inner in pairs(value) do
                if type(key) == "string" and DIRECTION_KEY_HINTS[string.lower(key)] then
                    local innerKind = typeof(inner)
                    if innerKind == "Vector3" and math.abs(inner.Magnitude - 1) < 0.02 then
                        value[key] = look
                        changed = true
                    elseif innerKind == "CFrame" then
                        value[key] = CFrame.new(inner.Position) * CFrame.lookAt(Vector3.zero, look)
                        changed = true
                    end
                end
            end
        end
    end

    return changed
end

local function buildShootDetour(originalCallable)
    return function(...)
        local packed = table.pack(...)
        local okRewrite, rewriteResult = pcall(rewriteDirectionArguments, packed)
        if not okRewrite then
            diag("warn", "shoot rewrite raised; calling original untouched: " .. tostring(rewriteResult))
        end

        local workspace = Services.Workspace
        local camera = workspace and workspace.CurrentCamera
        ShotBus.fire(camera and camera.CFrame.LookVector or nil, camera and camera.CFrame or nil)

        return originalCallable(table.unpack(packed, 1, packed.n))
    end
end

function NoSpread.installShootDetour()
    local weapon = Surface.findWeaponModule()
    if not weapon then
        return false, "weapon module unavailable"
    end

    local shoot = weapon.shoot
    if type(shoot) ~= "function" then
        return false, "shoot is not callable"
    end

    if EXEC.hook then
        -- The detour needs the unhooked clone, and the clone only exists after
        -- the hook is in place. A single forward-declared slot resolves the
        -- cycle without a second hook on the same closure.
        local inner = nil
        local detour = function(...)
            local packed = table.pack(...)
            local okRewrite, rewriteError = pcall(rewriteDirectionArguments, packed)
            if not okRewrite then
                diag("warn", "shoot rewrite raised; calling original untouched: " .. tostring(rewriteError))
            end

            local workspace = Services.Workspace
            local camera = workspace and workspace.CurrentCamera
            ShotBus.fire(camera and camera.CFrame.LookVector or nil, camera and camera.CFrame or nil)

            if inner then
                return inner(table.unpack(packed, 1, packed.n))
            end
            return nil
        end

        local okHook, unhooked = pcall(EXEC.hook, shoot, detour)
        if okHook and type(unhooked) == "function" then
            inner = unhooked
            NoSpread.detour = detour
            NoSpread.detourOriginal = unhooked
            NoSpread.detourKind = "hook"
            ShotBus.sourceKind = "hookfunction"
            return true
        end
    end

    local replacement = buildShootDetour(shoot)
    local okWrite = writeKey(weapon, "shoot", replacement)
    if okWrite then
        NoSpread.detour = replacement
        NoSpread.detourOriginal = shoot
        NoSpread.detourKind = "table"
        ShotBus.sourceKind = "table-write"
        return true
    end

    return false, "neither hookfunction nor a writable module table is available"
end

function NoSpread.installRandomHook()
    if not EXEC.hook then
        return false, "hookfunction unavailable"
    end
    local okHook, unhooked = pcall(EXEC.hook, math.random, spreadRandom)
    if okHook and type(unhooked) == "function" then
        NoSpread.randomHookOriginal = unhooked
        return true
    end
    return false, "math.random hook refused"
end

function NoSpread.enable()
    if NoSpread.enabled then
        return true
    end

    if not NoSpread.originalRandom and math.random ~= spreadRandom then
        NoSpread.originalRandom = math.random
    end

    local roots = NoSpread.collectRoots()
    local layerUpvalue = NoSpread.sweep(roots)
    local layerGlobal = NoSpread.patchGlobal()
    local layerShoot, shootError = NoSpread.installShootDetour()
    local layerHook = false

    if not layerUpvalue then
        layerHook = NoSpread.installRandomHook()
    end

    local parts = {}
    if layerShoot then
        parts[#parts + 1] = "shoot"
    end
    if layerUpvalue then
        parts[#parts + 1] = "up" .. tostring(NoSpread.upvalues)
    end
    if layerGlobal then
        parts[#parts + 1] = "global"
    end
    if layerHook then
        parts[#parts + 1] = "hookonly"
    end

    if #parts == 0 then
        NoSpread.mode = "none"
        diag("error", "no spread: no layer installed (" .. tostring(shootError) .. ")")
        return false, "no layer installed"
    end

    NoSpread.mode = table.concat(parts, "+")
    NoSpread.enabled = true
    diag("info", "no spread installed: " .. NoSpread.mode)
    return true
end

function NoSpread.restoreShootDetour()
    if NoSpread.detourKind == "hook" and EXEC.hook and NoSpread.detour and NoSpread.detourOriginal then
        -- Restoring a detour in this API is a re-hook: pointing the detour
        -- closure back at the original clone makes the hooked closure execute
        -- the original body again.
        safeCall("noSpread/unhook", EXEC.hook, NoSpread.detour, NoSpread.detourOriginal)
    elseif NoSpread.detourKind == "table" then
        local weapon = Surface.findWeaponModule()
        if weapon and NoSpread.detourOriginal then
            writeKey(weapon, "shoot", NoSpread.detourOriginal)
        end
    end

    NoSpread.detour = nil
    NoSpread.detourOriginal = nil
    NoSpread.detourKind = nil
    ShotBus.sourceKind = nil
end

function NoSpread.disable()
    for index = #NoSpread.restores, 1, -1 do
        local entry = NoSpread.restores[index]
        if EXEC.setUpvalue then
            safeCall("noSpread/restoreUpvalue", EXEC.setUpvalue, entry.fn, entry.index, entry.original)
        end
    end
    table.clear(NoSpread.restores)
    NoSpread.upvalues = 0

    if NoSpread.patchedGlobal and NoSpread.originalRandom then
        writeKey(math, "random", NoSpread.originalRandom)
        NoSpread.patchedGlobal = false
    end

    if NoSpread.randomHookOriginal and EXEC.hook then
        safeCall("noSpread/unhookRandom", EXEC.hook, spreadRandom, NoSpread.randomHookOriginal)
        NoSpread.randomHookOriginal = nil
    end

    NoSpread.restoreShootDetour()
    NoSpread.enabled = false
    NoSpread.mode = "off"
    diag("info", "no spread disabled")
end

function NoSpread.status()
    return NoSpread.mode
end

-- ============================================================================
-- 7. NO RECOIL
-- ============================================================================

local CORRECTION_FRAMES = 4
local RECOIL_FIELD_LIMIT = 32
local RECOIL_KEYWORDS = {
    "recoil",
    "punch",
    "kick",
    "camrecoil",
    "shotsomething",
    "sway",
}

local NoRecoil = {
    enabled = false,
    method = "auto",
    active = {},
    fieldRestores = {},
    upvalueRestores = {},
    visual = { active = false, snapshot = nil, frames = 0, unsubscribe = nil },
    renderConnection = nil,
}

local function matchesRecoilName(name)
    if type(name) ~= "string" then
        return false
    end
    local lowered = string.lower(name)
    for _, keyword in ipairs(RECOIL_KEYWORDS) do
        if string.find(lowered, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function zeroRecoilFields(root, limit)
    local found = 0
    walkGraph(root, 3, 4000, function(value, kind)
        if kind ~= "table" or found >= limit then
            return
        end
        for key, field in pairs(value) do
            if found >= limit then
                return
            end
            if type(key) == "string" and type(field) == "number" and field ~= 0 then
                if matchesRecoilName(key) then
                    local ok = writeKey(value, key, 0)
                    if ok then
                        NoRecoil.fieldRestores[#NoRecoil.fieldRestores + 1] = {
                            table = value,
                            key = key,
                            original = field,
                        }
                        found = found + 1
                    end
                end
            end
        end
    end)
    return found
end

local function zeroRecoilUpvalues(roots)
    if not EXEC.getUpvalues or not EXEC.setUpvalue or not EXEC.getUpvalueName then
        return 0
    end

    local found = 0
    for _, root in ipairs(roots) do
        walkGraph(root, 3, 2000, function(value, kind)
            if kind ~= "function" or found >= RECOIL_FIELD_LIMIT then
                return
            end

            local okList, list = pcall(EXEC.getUpvalues, value)
            if not okList or type(list) ~= "table" then
                return
            end

            for index = 1, #list do
                local current = list[index]
                if type(current) == "number" and current ~= 0 then
                    local okName, name = pcall(EXEC.getUpvalueName, value, index)
                    if okName and matchesRecoilName(name) then
                        local okSet = pcall(EXEC.setUpvalue, value, index, 0)
                        if okSet then
                            NoRecoil.upvalueRestores[#NoRecoil.upvalueRestores + 1] = {
                                fn = value,
                                index = index,
                                original = current,
                            }
                            found = found + 1
                        end
                    end
                end
            end
        end)
    end
    return found
end

function NoRecoil.zeroCamera()
    local cameraModule = Surface.findCameraController()
    if cameraModule == nil then
        return 0, "camera controller not located"
    end

    local found = zeroRecoilFields(cameraModule, RECOIL_FIELD_LIMIT)
    found = found + zeroRecoilUpvalues({ cameraModule })

    if found == 0 then
        return 0, "no recoil-named numeric field in the camera module"
    end

    return found
end

function NoRecoil.zeroWeaponStats()
    local inventory = Surface.requirePath({ "Controllers", "InventoryController" })
    local weapon = Surface.findWeaponModule()
    local roots = { inventory, weapon }
    local found = 0

    for _, root in ipairs(roots) do
        if root ~= nil then
            found = found + zeroRecoilFields(root, RECOIL_FIELD_LIMIT - found)
        end
    end

    if found == 0 then
        return 0, "no recoil-named numeric field in the weapon definition"
    end

    return found
end

function NoRecoil.onShot()
    local visual = NoRecoil.visual
    if not visual.active or isCharacterDead() then
        return
    end

    local workspace = Services.Workspace
    local camera = workspace and workspace.CurrentCamera
    if not camera then
        return
    end
    if camera.CameraType == Enum.CameraType.Scriptable then
        return
    end

    visual.snapshot = camera.CFrame
    visual.frames = CORRECTION_FRAMES
end

function NoRecoil.onRenderStep()
    local visual = NoRecoil.visual
    if not visual.active or not visual.snapshot or visual.frames <= 0 then
        return
    end

    local workspace = Services.Workspace
    local camera = workspace and workspace.CurrentCamera
    if not camera then
        visual.frames = 0
        return
    end
    if camera.CameraType == Enum.CameraType.Scriptable or isCharacterDead() then
        visual.frames = 0
        return
    end

    visual.frames = visual.frames - 1

    local current = camera.CFrame
    local currentRotation = current - current.Position
    local goalRotation = visual.snapshot - visual.snapshot.Position
    local alpha = 1 / (visual.frames + 1)
    local blended = currentRotation:Lerp(goalRotation, alpha)

    -- Rotation only: writing the position fights the game's camera spring and
    -- turns the correction into a visible tug-of-war.
    camera.CFrame = CFrame.new(current.Position) * blended
end

function NoRecoil.installVisual()
    if ShotBus.sourceKind == nil then
        return false, "shot detection unavailable (shoot detour not installed)"
    end
    if not Services.RunService then
        return false, "RunService unavailable"
    end

    NoRecoil.visual.active = true
    NoRecoil.visual.unsubscribe = ShotBus.subscribe(function()
        NoRecoil.onShot()
    end)

    if not NoRecoil.renderConnection then
        NoRecoil.renderConnection = connect(Services.RunService.RenderStepped, function()
            NoRecoil.onRenderStep()
        end)
    end

    if not NoRecoil.renderConnection then
        NoRecoil.visual.active = false
        if NoRecoil.visual.unsubscribe then
            NoRecoil.visual.unsubscribe()
            NoRecoil.visual.unsubscribe = nil
        end
        return false, "RenderStepped connection refused"
    end

    return true
end

function NoRecoil.enable(method)
    if NoRecoil.enabled then
        return true
    end

    method = method or NoRecoil.method or "auto"
    NoRecoil.method = method

    local wantCamera = method == "auto" or method == "camera"
    local wantStats = method == "auto" or method == "stats"
    local wantVisual = method == "auto" or method == "visual"
    local reasons = {}

    if wantCamera then
        local count, reason = NoRecoil.zeroCamera()
        if count > 0 then
            NoRecoil.active.camera = count
            diag("info", string.format("no recoil: camera mechanism zeroed %d field(s)", count))
        elseif reason then
            reasons[#reasons + 1] = reason
        end
    end

    if wantStats then
        local count, reason = NoRecoil.zeroWeaponStats()
        if count > 0 then
            NoRecoil.active.stats = count
            diag("info", string.format("no recoil: weapon stats zeroed %d field(s)", count))
        elseif reason then
            reasons[#reasons + 1] = reason
        end
    end

    if wantVisual and (method == "visual" or not (NoRecoil.active.camera or NoRecoil.active.stats)) then
        local okVisual, reason = NoRecoil.installVisual()
        if okVisual then
            NoRecoil.active.visual = CORRECTION_FRAMES
            diag("info", "no recoil: visual correction active (cosmetic, not a root-cause fix)")
        else
            reasons[#reasons + 1] = tostring(reason)
        end
    end

    if not (NoRecoil.active.camera or NoRecoil.active.stats or NoRecoil.active.visual) then
        diag("error", "no recoil: no mechanism resolved (" .. table.concat(reasons, "; ") .. ")")
        return false, "no mechanism resolved"
    end

    NoRecoil.enabled = true
    return true
end

function NoRecoil.disable()
    for index = #NoRecoil.fieldRestores, 1, -1 do
        local entry = NoRecoil.fieldRestores[index]
        writeKey(entry.table, entry.key, entry.original)
    end
    table.clear(NoRecoil.fieldRestores)

    for index = #NoRecoil.upvalueRestores, 1, -1 do
        local entry = NoRecoil.upvalueRestores[index]
        if EXEC.setUpvalue then
            safeCall("noRecoil/restoreUpvalue", EXEC.setUpvalue, entry.fn, entry.index, entry.original)
        end
    end
    table.clear(NoRecoil.upvalueRestores)

    if NoRecoil.visual.unsubscribe then
        NoRecoil.visual.unsubscribe()
        NoRecoil.visual.unsubscribe = nil
    end
    NoRecoil.visual.active = false
    NoRecoil.visual.snapshot = nil
    NoRecoil.visual.frames = 0

    dropConnection(NoRecoil.renderConnection)
    NoRecoil.renderConnection = nil

    table.clear(NoRecoil.active)
    NoRecoil.enabled = false
    diag("info", "no recoil disabled")
end

function NoRecoil.status()
    local parts = {}
    for key in pairs(NoRecoil.active) do
        parts[#parts + 1] = key
    end
    table.sort(parts)
    if #parts == 0 then
        return "off"
    end
    return table.concat(parts, "+")
end

