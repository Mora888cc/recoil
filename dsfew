local function viewportSize()
    local workspace = Services.Workspace
    local camera = workspace and workspace.CurrentCamera
    if camera then
        return camera.ViewportSize
    end
    return Vector2.new(1280, 720)
end

local function clampWindowPosition(offsetX, offsetY)
    local window = Gui.window
    if not window then
        return UDim2.fromOffset(offsetX, offsetY)
    end

    local size = window.AbsoluteSize
    local viewport = viewportSize()
    local maxX = math.max(0, viewport.X - size.X)
    local maxY = math.max(0, viewport.Y - size.Y)

    return UDim2.fromOffset(clamp(offsetX, 0, maxX), clamp(offsetY, 0, maxY))
end

local function applyStoredPosition()
    local window = Gui.window
    if not window then
        return
    end
    local storedX = Config.get("windowX") or 40
    local storedY = Config.get("windowY") or 80
    window.Position = clampWindowPosition(storedX, storedY)
end

local function parentForGui()
    local coreGui = Services.CoreGui
    if coreGui then
        local ok, writable = pcall(function()
            local probe = Instance.new("Folder")
            probe.Name = "penaProbe"
            probe.Parent = coreGui
            probe:Destroy()
            return true
        end)
        if ok and writable then
            return coreGui
        end
        diag("warn", "CoreGui is not writable here; falling back to PlayerGui")
    end

    local players = Services.Players
    local player = players and players.LocalPlayer
    if player then
        local okGui, playerGui = pcall(function()
            return player:FindFirstChildOfClass("PlayerGui")
        end)
        if okGui and playerGui then
            return playerGui
        end
    end

    return nil
end

local unload

local function refreshDiagnosticsText()
    local label = Gui.diagnosticsLabel
    if not label then
        return
    end

    local header = {
        "exec  : " .. (EXEC.identify and "available" or "unknown"),
        "spread: " .. NoSpread.status(),
        "recoil: " .. NoRecoil.status(),
    }

    local lines = Diag.snapshot(6)
    local buffer = table.concat(header, "\n")

    if #lines > 0 then
        buffer = buffer .. "\n" .. table.concat(lines, "\n")
    else
        buffer = buffer .. "\n(no events yet)"
    end

    label.Text = buffer
end

local function makeDiagnosticsPanel(parent)
    local frame = newInstance("Frame", {
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Size = UDim2.new(1, 0, 0, Theme.diagnosticsHeight),
        Visible = Config.get("diagnosticsOpen") == true,
    }, parent)

    if not frame then
        return nil
    end

    newInstance("UICorner", { CornerRadius = UDim.new(0, Theme.corner) }, frame)
    newInstance("UIStroke", {
        Color = Theme.border,
        Thickness = Theme.borderThickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = 0.7,
    }, frame)

    local scroll = newInstance("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(Theme.padding, Theme.gap),
        Size = UDim2.new(1, -(Theme.padding * 2), 1, -(Theme.gap * 2)),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.border,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, frame)

    local label = newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Theme.fontMono,
        Text = "diagnostics",
        TextColor3 = Theme.textDim,
        TextSize = Theme.textSizeSmall,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    }, scroll)

    Gui.diagnosticsFrame = frame
    Gui.diagnosticsLabel = label

    return frame
end

local function currentKeyCode()
    local name = Config.get("keybind") or "Insert"
    local keyCode = Enum.KeyCode[name]
    if keyCode then
        return keyCode
    end
    return Enum.KeyCode.Insert
end

local function setCollapsed(collapsed)
    Gui.body.Visible = not collapsed
    Config.set("collapsed", collapsed)
    if Gui.chevron then
        Gui.chevron.Text = collapsed and "+" or "-"
    end
end

local function buildWindow()
    local parent = parentForGui()
    if not parent then
        diag("error", "no GUI parent available; window cannot be created")
        return false
    end

    local executorName = "unknown"
    if EXEC.identify then
        local okIdentify, name = pcall(EXEC.identify)
        if okIdentify and type(name) == "string" and name ~= "" then
            executorName = name
        end
    end

    local screenGui = newInstance("ScreenGui", {
        Name = "pena",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, parent)

    if not screenGui then
        return false
    end
    Gui.screenGui = screenGui

    local window = newInstance("Frame", {
        Name = "Window",
        BackgroundColor3 = Theme.background,
        BackgroundTransparency = Theme.backgroundTransparency,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        Size = UDim2.fromOffset(Theme.windowWidth, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromOffset(Config.get("windowX"), Config.get("windowY")),
    }, screenGui)

    if not window then
        return false
    end
    Gui.window = window

    newInstance("UICorner", { CornerRadius = UDim.new(0, 6) }, window)
    newInstance("UIStroke", {
        Color = Theme.border,
        Thickness = Theme.borderThickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = 0.2,
    }, window)

    local titleBar = newInstance("TextButton", {
        Name = "TitleBar",
        BackgroundColor3 = Theme.surface,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.titleHeight),
        Text = "",
    }, window)
    Gui.titleBar = titleBar

    if not titleBar then
        diag("error", "title bar could not be created")
        return false
    end

    newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(Theme.padding, 0),
        Size = UDim2.new(0.6, -Theme.padding, 1, 0),
        Font = Theme.fontBold,
        Text = "pena // spread+recoil",
        TextColor3 = Theme.text,
        TextSize = Theme.textSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, titleBar)

    newInstance("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -50, 0.5, 0),
        Size = UDim2.new(0.4, -8, 1, 0),
        Font = Theme.font,
        Text = executorName,
        TextColor3 = Theme.textDim,
        TextSize = Theme.textSizeSmall,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, titleBar)

    Gui.chevron = newInstance("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -26, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Theme.surface,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Font = Theme.fontBold,
        Text = "-",
        TextColor3 = Theme.textDim,
        TextSize = Theme.textSize,
    }, titleBar)

    newInstance("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Theme.surface,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Font = Theme.fontBold,
        Text = "x",
        TextColor3 = Theme.textDim,
        TextSize = Theme.textSize,
    }, titleBar)

    local body = newInstance("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, window)
    Gui.body = body

    newInstance("UIPadding", {
        PaddingTop = UDim.new(0, Theme.padding),
        PaddingBottom = UDim.new(0, Theme.padding),
        PaddingLeft = UDim.new(0, Theme.padding),
        PaddingRight = UDim.new(0, Theme.padding),
    }, body)

    newInstance("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, Theme.gap),
    }, body)

    local toggleSpread = makeToggle(body, "No Spread", Config.get("noSpread"), function(state)
        Config.set("noSpread", state)
        if state then
            NoSpread.enable()
        else
            NoSpread.disable()
        end
        refreshDiagnosticsText()
    end)

    local toggleRecoil = makeToggle(body, "No Recoil", Config.get("noRecoil"), function(state)
        Config.set("noRecoil", state)
        if state then
            NoRecoil.enable(Config.get("recoilMethod"))
        else
            NoRecoil.disable()
        end
        refreshDiagnosticsText()
    end)

    local selectorMethod = makeSelector(body, "Recoil method", RECOIL_METHODS, Config.get("recoilMethod"), function(value)
        Config.set("recoilMethod", value)
        NoRecoil.method = value
        if NoRecoil.enabled then
            NoRecoil.disable()
            NoRecoil.enable(value)
        end
        refreshDiagnosticsText()
    end)
    Gui.selectorMethod = selectorMethod

    local keybindButton = makeButton(body, "Keybind: " .. tostring(Config.get("keybind")), function()
        Gui.awaitingKeybind = true
        keybindButton.set("Keybind: press a key")
    end)
    Gui.keybindButton = keybindButton

    local diagButton = makeButton(body, "Diagnostics", function()
        local frame = Gui.diagnosticsFrame
        if not frame then
            return
        end
        frame.Visible = not frame.Visible
        Config.set("diagnosticsOpen", frame.Visible)
    end)
    Gui.diagButton = diagButton

    local actionRow = newInstance("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.buttonHeight),
    }, body)

    newInstance("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, Theme.gap),
    }, actionRow)

    local saveButton = makeButton(actionRow, "Save", function()
        Config.save()
        refreshDiagnosticsText()
    end)
    saveButton.set(Config.persistenceAvailable() and "Save" or "Save (n/a)")

    local loadButton = makeButton(actionRow, "Load", function()
        Config.load()
        toggleSpread.set(Config.get("noSpread"), true)
        toggleRecoil.set(Config.get("noRecoil"), true)
        selectorMethod.set(Config.get("recoilMethod"), true)
        keybindButton.set("Keybind: " .. tostring(Config.get("keybind")))
        if toggleSpread.get() then
            NoSpread.enable()
        else
            NoSpread.disable()
        end
        if toggleRecoil.get() then
            NoRecoil.enable(Config.get("recoilMethod"))
        else
            NoRecoil.disable()
        end
        refreshDiagnosticsText()
    end)

    if not Config.persistenceAvailable() then
        saveButton.set("Save (n/a)")
    end

    if actionRow then
        for _, child in ipairs(actionRow:GetChildren()) do
            if child:IsA("GuiObject") and string.find(child.Name, "Button_", 1, true) then
                child.Size = UDim2.new(0.5, -Theme.gap / 2, 0, Theme.buttonHeight)
            end
        end
    end

    makeDiagnosticsPanel(body)

    makeButton(body, "Unload", function()
        unload()
    end)

    connect(titleBar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            Gui.dragging = true
            Gui.dragStart = input.Position
            Gui.dragOrigin = window.Position
        end
    end)

    connect(Services.UserInputService and Services.UserInputService.InputChanged, function(input)
        if not Gui.dragging or not Gui.dragStart or not Gui.dragOrigin then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - Gui.dragStart
        local nextX = Gui.dragOrigin.X.Offset + delta.X
        local nextY = Gui.dragOrigin.Y.Offset + delta.Y
        window.Position = clampWindowPosition(nextX, nextY)
    end)

    connect(Services.UserInputService and Services.UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if Gui.dragging then
                Gui.dragging = false
                Gui.dragStart = nil
                Gui.dragOrigin = nil
                Config.set("windowX", window.Position.X.Offset)
                Config.set("windowY", window.Position.Y.Offset)
            end
        end
    end)

    if Gui.chevron then
        connect(Gui.chevron.MouseButton1Click, function()
            setCollapsed(Gui.body.Visible)
        end)
    end

    connect(titleBar.MouseButton2Click, function()
        Gui.hidden = true
        window.Visible = false
    end)

    local closeButton = titleBar:FindFirstChild("Close")
    if closeButton then
        connect(closeButton.MouseButton1Click, function()
            unload()
        end)
    end

    connect(Services.UserInputService and Services.UserInputService.InputBegan, function(input, processed)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if Gui.awaitingKeybind then
                Gui.awaitingKeybind = false
                Config.set("keybind", input.KeyCode.Name)
                keybindButton.set("Keybind: " .. input.KeyCode.Name)
                refreshDiagnosticsText()
                return
            end
            if processed then
                return
            end
            if input.KeyCode == currentKeyCode() then
                Gui.hidden = not Gui.hidden
                window.Visible = not Gui.hidden
            end
        end
    end)

    local workspace = Services.Workspace
    local camera = workspace and workspace.CurrentCamera
    if camera then
        connect(camera:GetPropertyChangedSignal("ViewportSize"), function()
            applyStoredPosition()
        end)
    end

    connect(Services.RunService and Services.RunService.Heartbeat, function()
        refreshDiagnosticsText()
    end)

    local players = Services.Players
    if players then
        local player = players.LocalPlayer
        if player then
            connect(player.CharacterAdded, function()
                Surface.clearCache()
                diag("info", "character respawned; surface cache cleared")
                task.defer(function()
                    if NoRecoil.enabled then
                        NoRecoil.disable()
                        NoRecoil.enable(Config.get("recoilMethod"))
                    end
                end)
            end)
        end
    end

    Gui.toggleSpread = toggleSpread
    Gui.toggleRecoil = toggleRecoil
    Gui.executorName = executorName

    applyStoredPosition()
    if Config.get("collapsed") then
        setCollapsed(true)
    end

    return true
end

unload = function()
    if Gui.screenGui then
        safeCall("unload/destroyGui", function()
            Gui.screenGui:Destroy()
        end)
        Gui.screenGui = nil
    end

    NoRecoil.disable()
    NoSpread.disable()
    ShotBus.clear()
    disconnectAll()
    Diag.clear()

    table.clear(Gui.widgets)
    Gui.window = nil
    Gui.titleBar = nil
    Gui.body = nil
    Gui.diagnosticsFrame = nil
    Gui.diagnosticsLabel = nil
    Gui.dragging = false
    Gui.dragStart = nil
    Gui.dragOrigin = nil
    Gui.awaitingKeybind = false

    Surface.clearCache()

    local API = rawget(REGISTRY_ENV, "__pena")
    if type(API) == "table" and type(API.unload) == "function" and API.unload == unload then
        REGISTRY_ENV.__pena = nil
    end
end

-- ============================================================================
-- 11. BOOTSTRAP
-- ============================================================================

local API = {
    version = "1.0.0",
    unload = unload,
    config = Config,
    noSpread = NoSpread,
    noRecoil = NoRecoil,
    diagnostics = Diag,
}

REGISTRY_ENV.__pena = API

local function bootstrap()
    Config.load()

    local executorName = "unknown"
    if EXEC.identify then
        local okIdentify, name = pcall(EXEC.identify)
        if okIdentify and type(name) == "string" and name ~= "" then
            executorName = name
        end
    end

    diag("info", "pena " .. API.version .. " | executor: " .. executorName)
    diag("info", "persistence: " .. (Config.persistenceAvailable() and "available" or "in-memory only"))

    if not buildWindow() then
        diag("warn", "running headless: features still install, no window")
    end

    if Config.get("noSpread") then
        NoSpread.enable()
    end

    if Config.get("noRecoil") then
        NoRecoil.enable(Config.get("recoilMethod"))
    end

    refreshDiagnosticsText()

    print(string.format(
        "[pena] loaded %s | spread: %s | recoil: %s | key: %s",
        API.version,
        NoSpread.status(),
        NoRecoil.status(),
        tostring(Config.get("keybind"))
    ))
end

local okBootstrap, bootstrapError = xpcall(bootstrap, function(message)
    return tostring(message) .. "\n" .. debug.traceback()
end)

if not okBootstrap then
    warn("[pena] bootstrap failed: " .. tostring(bootstrapError))
end

