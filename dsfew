local DIAG_CAPACITY = 48

Diag = {
    events = {},
}

function Diag.push(level, text)
    local entry = {
        level = tostring(level),
        text = tostring(text),
        time = os.clock(),
    }

    local events = Diag.events
    events[#events + 1] = entry
    if #events > DIAG_CAPACITY then
        table.remove(events, 1)
    end

    return entry
end

function Diag.snapshot(tailCount)
    local events = Diag.events
    local total = #events
    local wanted = tailCount or total
    local start = math.max(1, total - wanted + 1)
    local lines = {}

    for index = start, total do
        local entry = events[index]
        lines[#lines + 1] = string.format("%6.2fs  %-5s %s", entry.time, entry.level, entry.text)
    end

    return lines
end

function Diag.clear()
    table.clear(Diag.events)
end

