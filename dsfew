local Config = {}

local CONFIG_FOLDER = "pena"
local CONFIG_FILE = "pena/config.json"
local RECOIL_METHODS = { "auto", "camera", "stats", "visual" }

local DEFAULTS = {
    noSpread = true,
    noRecoil = true,
    recoilMethod = "auto",
    keybind = "Insert",
    windowX = 40,
    windowY = 80,
    collapsed = false,
    diagnosticsOpen = true,
}

Config.values = {}
for key, value in pairs(DEFAULTS) do
    Config.values[key] = value
end

local function isRecoilMethod(value)
    if type(value) ~= "string" then
        return false
    end
    for _, method in ipairs(RECOIL_METHODS) do
        if method == value then
            return true
        end
    end
    return false
end

function Config.validate(source)
    local validated = {}
    for key, fallback in pairs(DEFAULTS) do
        validated[key] = fallback
    end

    if type(source) ~= "table" then
        return validated
    end

    if type(source.noSpread) == "boolean" then
        validated.noSpread = source.noSpread
    end
    if type(source.noRecoil) == "boolean" then
        validated.noRecoil = source.noRecoil
    end
    if isRecoilMethod(source.recoilMethod) then
        validated.recoilMethod = source.recoilMethod
    end
    if type(source.keybind) == "string" and Enum.KeyCode[source.keybind] then
        validated.keybind = source.keybind
    end
    if type(source.windowX) == "number" then
        validated.windowX = clamp(round(source.windowX), 0, 4096)
    end
    if type(source.windowY) == "number" then
        validated.windowY = clamp(round(source.windowY), 0, 4096)
    end
    if type(source.collapsed) == "boolean" then
        validated.collapsed = source.collapsed
    end
    if type(source.diagnosticsOpen) == "boolean" then
        validated.diagnosticsOpen = source.diagnosticsOpen
    end

    return validated
end

function Config.persistenceAvailable()
    return EXEC.writeFile ~= nil and EXEC.readFile ~= nil
end

function Config.save()
    if not Config.persistenceAvailable() or not Services.HttpService then
        return false, "persistence unavailable"
    end

    if EXEC.isFolder and EXEC.makeFolder then
        local okFolder, exists = pcall(EXEC.isFolder, CONFIG_FOLDER)
        if not okFolder or not exists then
            safeCall("config/makeFolder", EXEC.makeFolder, CONFIG_FOLDER)
        end
    elseif EXEC.makeFolder then
        safeCall("config/makeFolder", EXEC.makeFolder, CONFIG_FOLDER)
    end

    local okEncode, encoded = pcall(function()
        return Services.HttpService:JSONEncode(Config.values)
    end)
    if not okEncode or type(encoded) ~= "string" then
        diag("error", "config encode failed: " .. tostring(encoded))
        return false, "encode failed"
    end

    local okWrite = safeCall("config/writeFile", EXEC.writeFile, CONFIG_FILE, encoded)
    if not okWrite then
        return false, "write failed"
    end

    diag("info", "config saved to " .. CONFIG_FILE)
    return true
end

function Config.load()
    if not Config.persistenceAvailable() or not Services.HttpService then
        return false, "persistence unavailable"
    end

    if EXEC.isFile then
        local okExists, exists = pcall(EXEC.isFile, CONFIG_FILE)
        if not okExists or not exists then
            return false, "no config file"
        end
    end

    local okRead, contents = pcall(EXEC.readFile, CONFIG_FILE)
    if not okRead or type(contents) ~= "string" or contents == "" then
        diag("warn", "config read failed; using defaults")
        return false, "read failed"
    end

    local okDecode, decoded = pcall(function()
        return Services.HttpService:JSONDecode(contents)
    end)
    if not okDecode then
        diag("warn", "config decode failed; using defaults")
        return false, "decode failed"
    end

    local validated = Config.validate(decoded)
    for key, value in pairs(validated) do
        Config.values[key] = value
    end

    diag("info", "config loaded from " .. CONFIG_FILE)
    return true
end

function Config.get(key)
    return Config.values[key]
end

function Config.set(key, value)
    if DEFAULTS[key] == nil then
        return false
    end
    Config.values[key] = value
    return true
end

