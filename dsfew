-- ============================================================================
-- 1. IDEMPOTENT UNLOAD OF ANY PREVIOUS INSTANCE
-- ============================================================================

local REGISTRY_ENV = _G
do
    local ok, env = pcall(function()
        return getgenv()
    end)
    if ok and type(env) == "table" then
        REGISTRY_ENV = env
    end
end

do
    local previous = rawget(REGISTRY_ENV, "__pena")
    if type(previous) == "table" and type(previous.unload) == "function" then
        local ok, err = pcall(previous.unload)
        if not ok then
            warn("[pena] previous instance failed to unload cleanly: " .. tostring(err))
        end
    end
end

