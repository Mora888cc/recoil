local function newInstance(className, properties, parent)
    local ok, instance = pcall(Instance.new, className)
    if not ok or not instance then
        diag("error", "Instance.new failed for " .. tostring(className))
        return nil
    end

    for key, value in pairs(properties) do
        local okSet = pcall(function()
            instance[key] = value
        end)
        if not okSet then
            diag("warn", string.format("property %s rejected on %s", tostring(key), tostring(className)))
        end
    end

    if parent then
        instance.Parent = parent
    end

    Gui.widgets[#Gui.widgets + 1] = instance
    return instance
end

local function tween(instance, duration, properties)
    local tweenService = Services.TweenService
    if not tweenService then
        for key, value in pairs(properties) do
            safeCall("tween/set", function()
                instance[key] = value
            end)
        end
        return
    end

    local info = TweenInfo.new(duration or Theme.tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local ok, animation = pcall(function()
        return tweenService:Create(instance, info, properties)
    end)
    if ok and animation then
        safeCall("tween/play", function()
            animation:Play()
        end)
    end
end

local function paintInteractive(button, baseColor, hoverColor, pressColor)
    connect(button.MouseEnter, function()
        tween(button, Theme.tweenTime, { BackgroundColor3 = hoverColor })
    end)
    connect(button.MouseLeave, function()
        tween(button, Theme.tweenTime, { BackgroundColor3 = baseColor })
    end)
    connect(button.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            button.BackgroundColor3 = pressColor
        end
    end)
    connect(button.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            tween(button, Theme.tweenTime, { BackgroundColor3 = hoverColor })
        end
    end)
end

local function makeToggle(parent, labelText, initialValue, onChanged)
    local row = newInstance("TextButton", {
        Name = "Toggle_" .. tostring(labelText),
        BackgroundColor3 = Theme.surface,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.rowHeight),
        Text = "",
    }, parent)

    if not row then
        return { set = function() end, get = function() return false end, destroy = function() end }
    end

    newInstance("UICorner", { CornerRadius = UDim.new(0, Theme.corner) }, row)
    newInstance("UIStroke", {
        Color = Theme.border,
        Thickness = Theme.borderThickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = 0.45,
    }, row)

    local label = newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(Theme.padding, 0),
        Size = UDim2.new(1, -(Theme.padding * 2) - 34, 1, 0),
        Font = Theme.font,
        Text = labelText,
        TextColor3 = Theme.text,
        TextSize = Theme.textSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local track = newInstance("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -Theme.padding, 0.5, 0),
        Size = UDim2.fromOffset(28, 14),
        BackgroundColor3 = Theme.accentDim,
        BorderSizePixel = 0,
    }, row)

    if track then
        newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
    end

    local knob = newInstance("Frame", {
        Position = UDim2.fromOffset(2, 2),
        Size = UDim2.fromOffset(10, 10),
        BackgroundColor3 = Theme.textDim,
        BorderSizePixel = 0,
    }, track)

    if knob then
        newInstance("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
    end

    local state = initialValue == true

    local function paint()
        if track then
            track.BackgroundColor3 = state and Theme.accent or Theme.accentDim
        end
        if knob then
            knob.BackgroundColor3 = state and Theme.accentText or Theme.textDim
            tween(knob, Theme.tweenTime, {
                Position = state and UDim2.fromOffset(16, 2) or UDim2.fromOffset(2, 2),
            })
        end
        if label then
            label.TextColor3 = state and Theme.text or Theme.textDim
        end
    end

    local handle = {}

    function handle.get()
        return state
    end

    function handle.set(value, silent)
        local nextState = value == true
        if nextState == state then
            paint()
            return
        end
        state = nextState
        paint()
        if not silent and onChanged then
            local okCall, err = pcall(onChanged, state)
            if not okCall then
                diag("error", "toggle handler failed: " .. tostring(err))
            end
        end
    end

    function handle.destroy()
        if row then
            row:Destroy()
            row = nil
        end
    end

    paint()
    paintInteractive(row, Theme.surface, Theme.surfaceHover, Theme.surfacePress)
    connect(row.MouseButton1Click, function()
        handle.set(not state)
    end)

    return handle
end

